# ==============================================================================
# Velora Environment Configuration Template
# Copy this file to .env.local for local development, or .env for Docker Compose.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (PostgreSQL Database & Authentication)
# Obtain from your Supabase project settings: https://app.supabase.com/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:9999

# ------------------------------------------------------------------------------
# AI & Large Language Models (NVIDIA NIM)
# Used for contextual financial skill execution, transcript synthesis, and Q&A.
# Obtain from: https://build.nvidia.com/
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key
NVIDIA_DEFAULT_MODEL=mistralai/mistral-nemotron
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# ------------------------------------------------------------------------------
# Market & Financial Data Feeds
# ------------------------------------------------------------------------------
# Finnhub: Real-time quotes, company profiles, analyst signals, insider trades, and earnings.
# Obtain from: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key

# MarketAux: Real-time global financial news and sentiment streams.
# Obtain from: https://www.marketaux.com/
MARKETAUX_API_KEY=your_marketaux_api_key

# FRED (Federal Reserve Economic Data): Macro indicators & VIX index data.
# Obtain from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key

# Financial Modeling Prep (FMP): Supplementary fundamental data (optional).
# Obtain from: https://site.financialmodelingprep.com/
FMP_API_KEY=your_fmp_api_key

# ------------------------------------------------------------------------------
# Web Search & Intelligence Engines
# ------------------------------------------------------------------------------
# Brave Search API: Real-time web retrieval for market context and breaking news.
# Obtain from: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your_brave_search_api_key
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# Tavily AI Search: Agentic search and deep financial document retrieval (optional).
# Obtain from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key
